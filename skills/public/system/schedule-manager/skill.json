{
  "name": "schedule-manager",
  "title": "Schedule Manager",
  "version": "1.1.0",
  "status": "public",
  "visibility": "public",
  "kind": "agent",
  "description": "List, enable, disable, or delete Windows scheduled tasks by index, list, range, or keyword.",
  "tags": ["windows", "schedule", "tasks", "cleanup", "automation"],
  "author": "wzlwit",
  "license": "MIT",
  "homepage": "https://github.com/wzlwit/skillvault",
  "source": {
    "repo": "skillvault",
    "path": "skills/public/system/schedule-manager"
  },
  "install": {
    "global": true,
    "project": false,
    "session": false,
    "defaultScope": "global",
    "globalPath": "~/.copilot/skills",
    "strategy": "copy"
  },
  "inputs": [
    {
      "name": "action",
      "required": false,
      "type": "string",
      "default": "list",
      "enum": ["list", "enable", "disable", "delete", "remove", "uninstall"],
      "description": "Action to run. Defaults to list. remove and uninstall are aliases for delete."
    },
    {
      "name": "selector",
      "required": false,
      "type": "string",
      "description": "Required for enable, disable, or delete. Indexes, ranges, comma lists, or keywords. Examples: 2, 1,3, 4-6, SkillVault."
    }
  ],
  "outputs": ["indexed-schedule-list", "schedule-enable-summary", "schedule-disable-summary", "schedule-delete-summary"],
  "dependencies": [],
  "examples": [
    "/schedule-manager",
    "/schedule-manager enable 2",
    "/schedule-manager disable SkillVault",
    "/schedule-manager delete 2",
    "/schedule-manager delete 1,3-5",
    "/schedule-manager delete SkillVault"
  ],
  "readme": "SKILL.md"
}